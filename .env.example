# Copy this file to .env and fill in real values.
# Never commit .env.

# Twelve Data: https://twelvedata.com/apikey
TWELVE_DATA_API_KEY=
TWELVE_DATA_API_KEY_SECOND=

# Telegram Bot API (same mechanism as the Laravel sendMessage call).
# TELEGRAM_BOT_TOKEN is the token BotFather gave you (no "bot" prefix).
# TELEGRAM_CHAT_ID is the numeric chat or channel id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
LOG_LEVEL=INFO
SCAN_INTERVAL_SECONDS=1800
PORT=8080

# Optional public crypto validation feeds. These do not require API keys.
CRYPTO_BINANCE_VALIDATION_ENABLED=true
CRYPTO_COINBASE_VALIDATION_ENABLED=true
CRYPTO_BINANCE_MAX_PRICE_DISCREPANCY_PCT=1.0
CRYPTO_COINBASE_MAX_PRICE_DISCREPANCY_PCT=1.0
CRYPTO_BINANCE_STALE_SECONDS=60
CRYPTO_COINBASE_STALE_SECONDS=60
CRYPTO_BINANCE_MAX_CONNECTION_SECONDS=82800
CRYPTO_VALIDATION_RECONNECT_SECONDS=5
CRYPTO_VALIDATION_HTTP_TIMEOUT_SECONDS=10
CRYPTO_VALIDATION_CANDLE_REFRESH_SECONDS=60

# Optional FXCM bridge receiver. FXCM credentials belong only in the separate bridge.
FXCM_BRIDGE_ENABLED=false
FXCM_BRIDGE_SHARED_SECRET=
FXCM_ACCOUNT_TYPE=demo
FXCM_STALE_SECONDS=90
FXCM_MAX_PRICE_DISCREPANCY_PCT=0.1

# Optional TradingView email bridge. Keep disabled until the parser is tested.
TRADINGVIEW_EMAIL_ENABLED=false
TRADINGVIEW_EMAIL_HOST=imap.gmail.com
TRADINGVIEW_EMAIL_PORT=993
TRADINGVIEW_EMAIL_USERNAME=
TRADINGVIEW_EMAIL_PASSWORD=
TRADINGVIEW_EMAIL_FOLDER=INBOX
TRADINGVIEW_EMAIL_POLL_INTERVAL=30
TRADINGVIEW_EMAIL_DRY_RUN=true
TRADINGVIEW_PROCESS_EXISTING_ON_START=false
TRADINGVIEW_ALLOWED_SENDER=tradingview.com
